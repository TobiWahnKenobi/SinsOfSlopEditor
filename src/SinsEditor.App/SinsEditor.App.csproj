<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SinsEditor.Core\SinsEditor.Core.csproj" />
    <ProjectReference Include="..\SinsEditor.Viewer\SinsEditor.Viewer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logo for light backgrounds (black lines) and dark backgrounds (white lines). -->
    <Resource Include="Assets\Logo.png" />
    <Resource Include="Assets\Logo-White.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SinsOfSlopEditor</AssemblyName>
    <RootNamespace>SinsEditor.App</RootNamespace>
    <Product>Sins of Slop Editor</Product>
    <Version>0.1.0</Version>
    <Company>lt-design</Company>
    <Copyright>© Tobias Liebhart / lt-design</Copyright>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- ThemeMode (Fluent theme) is marked experimental in .NET 9. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

</Project>
