<Window x:Class="SinsEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SinsEditor.App.ViewModels"
        xmlns:views="clr-namespace:SinsEditor.App.Views"
        xmlns:nav="clr-namespace:SinsEditor.App.Navigation"
        xmlns:research="clr-namespace:SinsEditor.App.Research"
        xmlns:brushes="clr-namespace:SinsEditor.App.BrushEditing"
        xmlns:assets="clr-namespace:SinsEditor.App.Assets"
        Title="{Binding WindowTitle}"
        Width="1400" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoryViewModel}"><views:CategoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EntityViewModel}"><views:EntityView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RaceViewModel}"><views:RaceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProblemsViewModel}"><views:ProblemsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameLogViewModel}"><views:GameLogView /></DataTemplate>
        <DataTemplate DataType="{x:Type assets:AssetListViewModel}"><views:AssetListView /></DataTemplate>
        <DataTemplate DataType="{x:Type assets:MeshViewModel}"><views:MeshView /></DataTemplate>
        <DataTemplate DataType="{x:Type assets:TextureViewModel}"><views:TextureView /></DataTemplate>
        <DataTemplate DataType="{x:Type research:ResearchViewModel}"><views:ResearchView /></DataTemplate>
        <DataTemplate DataType="{x:Type brushes:BrushListViewModel}"><views:BrushListView /></DataTemplate>
        <DataTemplate DataType="{x:Type brushes:BrushEditorViewModel}"><views:BrushEditorView /></DataTemplate>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding GoBackCommand}" />
        <KeyBinding Modifiers="Alt" Key="Right" Command="{Binding GoForwardCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="K" Command="{Binding Search.OpenCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="T" Command="{Binding NewTabCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="W" Command="{Binding CloseTabCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCurrentCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAllCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCurrentCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCurrentCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.Row="0" Margin="12,8" LastChildFill="True">
            <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Command="{Binding GoBackCommand}"
                    Content="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="Back (Alt+Left)" />
            <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Command="{Binding GoForwardCommand}"
                    Content="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="Forward (Alt+Right)" />
            <Grid DockPanel.Dock="Left" Margin="0,0,12,0">
                <ToggleButton x:Name="HistoryToggle" Padding="8,4" MinWidth="34" ToolTip="History"
                              Content="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Popup IsOpen="{Binding IsChecked, ElementName=HistoryToggle}" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=HistoryToggle}" Placement="Bottom" AllowsTransparency="True">
                    <Border Style="{StaticResource Card}" Padding="4" Width="420" MaxHeight="480"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="History" FontWeight="SemiBold" Margin="8,6" />
                            <TextBlock DockPanel.Dock="Top" Text="Pages you open appear here." Style="{StaticResource Muted}" Margin="8,0,8,8"
                                       Visibility="{Binding History.Count, Converter={StaticResource ZeroToVisible}}" />
                            <ListBox ItemsSource="{Binding History}" BorderThickness="0" MouseUp="HistoryList_MouseUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type nav:HistoryEntry}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Muted}" Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="Open mod…" Click="OpenMod_Click" />
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="Save all" Command="{Binding SaveAllCommand}"
                    ToolTip="Save every entity with unsaved changes (Ctrl+Shift+S)" />
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="Reload" Click="Reload_Click"
                    ToolTip="Read the mod's files again" />
            <Button DockPanel.Dock="Right" Command="{Binding Search.OpenCommand}" Margin="0,0,12,0" Padding="10,4" Width="260"
                    HorizontalContentAlignment="Left" ToolTip="Search everything (Ctrl+K)">
                <DockPanel Width="236">
                    <TextBlock DockPanel.Dock="Right" Text="Ctrl+K" Style="{StaticResource Muted}" />
                    <TextBlock Style="{StaticResource Muted}">
                        <Run Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <Run Text=" Search" />
                    </TextBlock>
                </DockPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Workspace.ModName}" Style="{StaticResource Muted}" />
                <TextBlock Text="  ›  " Style="{StaticResource Muted}"
                           Visibility="{Binding CurrentPage.Breadcrumb, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Text="{Binding CurrentPage.Breadcrumb}" Style="{StaticResource Muted}" />
                <TextBlock Text="  ›  " Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding CurrentPage.Title}" />
            </StackPanel>
        </DockPanel>

        <!-- Navigation and content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16,8,8,12">
                <Image Source="{DynamicResource Logo}" Height="40" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center" Width="150">
                    <TextBlock Text="{DynamicResource AppTitle}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource CopyrightText}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding NavItems}" Margin="8,0,4,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NavItem}">
                        <Button Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Target}" HorizontalContentAlignment="Stretch"
                                HorizontalAlignment="Stretch" Margin="0,1" Padding="10,6" BorderThickness="0"
                                ToolTip="Ctrl+click opens a new tab">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProblems}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Title}" />
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="4,0,12,12">
                <!-- Tab strip -->
                <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DocumentTab}">
                                    <Border x:Name="TabBorder" CornerRadius="6,6,0,0" Padding="12,6,6,6" Margin="0,0,2,0"
                                            MouseLeftButtonDown="Tab_MouseLeftButtonDown" MouseUp="Tab_MouseUp" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Text=" ●" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       ToolTip="Unsaved changes" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                    Padding="4" MinWidth="0" MinHeight="0" Margin="8,0,0,0" BorderThickness="0" Background="Transparent"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="Close tab (Ctrl+W)" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Padding="8,4"
                                BorderThickness="0" Background="Transparent" Command="{Binding NewTabCommand}" ToolTip="New tab (Ctrl+T)" />
                    </StackPanel>
                </ScrollViewer>

                <Border Style="{StaticResource Card}" Padding="0" CornerRadius="0,8,8,8">
                    <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
                </Border>
            </DockPanel>
        </Grid>

        <!-- Global search -->
        <Grid Grid.RowSpan="2" Background="#33000000" Visibility="{Binding Search.IsOpen, Converter={StaticResource BoolToVisibility}}"
              MouseDown="SearchOverlay_MouseDown" IsVisibleChanged="SearchOverlay_IsVisibleChanged">
            <Border Style="{StaticResource Card}" Width="680" VerticalAlignment="Top" Margin="0,70,0,0" Padding="8" MaxHeight="620"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" MouseDown="SearchPanel_MouseDown">
                <DockPanel>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Search.Status}" Style="{StaticResource Muted}" Margin="8,8,8,4"
                               Visibility="{Binding Search.Status, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="↑↓ select · Enter open · Ctrl+Enter open in new tab · Esc close"
                               Style="{StaticResource Muted}" FontSize="12" Margin="8,6,8,0" />
                    <ListBox x:Name="SearchResults" ItemsSource="{Binding Search.Results}" SelectedItem="{Binding Search.Selected}"
                             BorderThickness="0" Margin="0,6,0,0" MouseUp="SearchResults_MouseUp"
                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SearchResult}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Group}" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,2"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding IsFirstInGroup, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Loading and error overlay -->
        <Border Grid.RowSpan="2" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                <Image Source="{DynamicResource Logo}" Height="180" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{DynamicResource AppTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="{DynamicResource CopyrightText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,32" />
                <TextBlock Text="{Binding LoadingText}" Margin="0,0,0,12" HorizontalAlignment="Center" />
                <ProgressBar Value="{Binding LoadingProgress, Mode=OneWay}" Maximum="1" Height="4" />
                <TextBlock Text="The first time a game version is opened, its files are converted. Later openings are faster."
                           Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
        <Border Grid.RowSpan="2" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsed}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,16" />
                <Button Content="Open another mod…" HorizontalAlignment="Center" Click="OpenMod_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
