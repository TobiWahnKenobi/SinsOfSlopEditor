<Window x:Class="SinsEditor.App.Views.OpenModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SinsEditor.App.ViewModels"
        Title="{DynamicResource AppTitle}" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <DockPanel Margin="0,0,0,20">
            <Image DockPanel.Dock="Left" Source="{DynamicResource Logo}" Height="72" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource AppTitle}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Mod editor for Sins of a Solar Empire: Rebellion" Style="{StaticResource Muted}" />
                <TextBlock Text="{DynamicResource CopyrightText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>
        <TextBlock Text="Game folder" FontWeight="SemiBold" Margin="0,0,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseGameCommand}" Margin="8,0,0,0" />
            <TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <TextBlock Text="{Binding GameDirectoryError}" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"
                   Visibility="{Binding GameDirectoryError, Converter={StaticResource NullToCollapsed}}" />

        <TextBlock Text="Mod to edit" FontWeight="SemiBold" Margin="0,20,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseModCommand}" Margin="8,0,0,0" />
            <ComboBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModChoice}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Group}" Style="{StaticResource Muted}" Margin="16,0,0,0" />
                            <TextBlock Text="{Binding Name}" />
                        </DockPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>
        <TextBlock Text="{Binding SelectedMod.Path}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />

        <TextBlock Text="Base mods" FontWeight="SemiBold" Margin="0,20,0,0" />
        <TextBlock Text="Loaded read-only, in this order, on top of the base game. Each entry overrides the ones above it, and the edited mod overrides them all."
                   Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,6" />
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Width="96">
                <Button Content="Add…" Command="{Binding AddBaseModCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                <Button Content="Remove" Command="{Binding RemoveBaseModCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                <Button Content="Move up" Command="{Binding MoveUpCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                <Button Content="Move down" Command="{Binding MoveDownCommand}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <Grid>
                <ListBox ItemsSource="{Binding BaseMods}" SelectedItem="{Binding SelectedBaseMod}" DisplayMemberPath="Name" Height="130" />
                <TextBlock Text="None. Only the base game is used below the edited mod." Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Visibility>
                        <Binding Path="BaseMods.Count" Converter="{StaticResource ZeroToVisible}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
        </DockPanel>

        <TextBlock Text="Language" FontWeight="SemiBold" Margin="0,20,0,4" />
        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Width="240" HorizontalAlignment="Left" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button Content="Open" Command="{Binding OpenCommand}" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Margin="0,0,8,0" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="96" />
        </StackPanel>
    </StackPanel>
</Window>
