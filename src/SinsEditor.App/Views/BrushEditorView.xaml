<UserControl x:Class="SinsEditor.App.Views.BrushEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:br="clr-namespace:SinsEditor.App.BrushEditing"
             xmlns:ed="clr-namespace:SinsEditor.App.Editing"
             xmlns:conv="clr-namespace:SinsEditor.App.Converters">
    <UserControl.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <!-- Checkerboard behind images so transparency is visible. -->
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF3A3A3A" Geometry="M0,0 H2 V2 H0 Z" />
                    <GeometryDrawing Brush="#FF4A4A4A" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480" MinWidth="380" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,16,16">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

                <!-- Name, content, file -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Name" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=300}" IsEnabled="{Binding IsNew}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="Content" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ContentKinds}" SelectedItem="{Binding ContentKind}" IsEnabled="{Binding IsNew}" Margin="0,2"
                              ToolTip="Simple: one image. States: Normal, CursorOver, Pressed, Focused and Disabled, as buttons and icons use." />
                    <TextBlock Grid.Row="2" Text="Brushes file" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding BrushesFiles}" SelectedItem="{Binding BrushesFile}" IsEnabled="{Binding IsNew}" Margin="0,2" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding NewBrushesFile, UpdateSourceTrigger=PropertyChanged, Delay=300}" Margin="0,2"
                             Visibility="{Binding IsNewFile, Converter={StaticResource BoolToVisibility}}" ToolTip="New file in Window/; added to brush.manifest" />
                </Grid>

                <!-- Images per state -->
                <TextBlock Text="Images" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type br:StateSlot}">
                            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button Content="Import…" Command="{Binding DataContext.ImportImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Margin="0,0,0,4" />
                                        <Button Content="Undo import" Command="{Binding DataContext.ClearImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Visibility="{Binding Imported, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource Checker}" Margin="0,0,8,0" ToolTip="Now">
                                                <Image Source="{Binding Current}" MaxHeight="64" MaxWidth="120" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Muted}" />
                                            <Border Background="{StaticResource Checker}" ToolTip="After applying">
                                                <Image Source="{Binding Result}" MaxHeight="64" MaxWidth="120" Stretch="Uniform" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="Generate the other states from Normal" IsChecked="{Binding DeriveStates}" Margin="0,4,0,12"
                          ToolTip="CursorOver brighter, Pressed darker, Disabled grey. States with their own imported image keep it." />

                <!-- Size -->
                <TextBlock Text="Size" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="70" />
                    <TextBlock Text=" × " VerticalAlignment="Center" />
                    <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="70" Margin="0,0,12,0" />
                    <ComboBox ItemsSource="{Binding FitModes}" SelectedItem="{Binding FitMode}" Width="110"
                              ToolTip="Fit: keep proportions, transparent margins. Fill: keep proportions, crop. Stretch: exact size." />
                </StackPanel>

                <!-- Texture -->
                <TextBlock Text="Texture (atlas)" Style="{StaticResource SectionHeader}" />
                <RadioButton Content="{Binding KeepTextureText}" GroupName="Tex" Margin="0,2"
                             IsChecked="{Binding TextureChoice, Converter={StaticResource EnumEquals}, ConverterParameter=Keep}"
                             Visibility="{Binding CanKeepTexture, Converter={StaticResource BoolToVisibility}}" />
                <DockPanel Margin="0,2">
                    <RadioButton Content="Existing texture" GroupName="Tex" Width="140" VerticalAlignment="Center"
                                 IsChecked="{Binding TextureChoice, Converter={StaticResource EnumEquals}, ConverterParameter=Existing}" />
                    <ComboBox ItemsSource="{Binding Textures}" SelectedItem="{Binding OtherTexture}" IsTextSearchEnabled="True" />
                </DockPanel>
                <DockPanel Margin="0,2,0,12">
                    <RadioButton Content="New texture" GroupName="Tex" Width="140" VerticalAlignment="Center"
                                 IsChecked="{Binding TextureChoice, Converter={StaticResource EnumEquals}, ConverterParameter=New}" />
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding NewTextureFormats}" SelectedItem="{Binding NewTextureFormat}" Width="110" Margin="6,0,0,0"
                              ToolTip="TGA is what the game uses for most icons; DXT5 DDS is smaller" />
                    <TextBox Text="{Binding NewTexture, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                </DockPanel>

                <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                <Button Content="Apply" Command="{Binding ApplyCommand}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Left" MinWidth="120" />
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <!-- Result -->
        <DockPanel Grid.Column="2" Margin="16,20,24,16">
            <TextBlock DockPanel.Dock="Top" Text="Atlas after applying" Style="{StaticResource SectionHeader}" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding PlanSummary}" Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="Changes" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Changes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ed:ChangeRow}">
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Path}" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Notes}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <Border Background="{StaticResource Checker}" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image Source="{Binding AtlasPreview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
