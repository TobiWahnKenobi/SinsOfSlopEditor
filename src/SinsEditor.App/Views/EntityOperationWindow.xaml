<Window x:Class="SinsEditor.App.Views.EntityOperationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:SinsEditor.App.Editing"
        Icon="/Assets/App.ico" Title="{Binding Title}" Width="720" Height="640" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" IsDefault="True" MinWidth="96" Margin="0,0,8,0"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="96" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <!-- Template (duplicate / new) -->
            <StackPanel Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                <TextBlock Text="Template" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding Source}" IsTextSearchEnabled="True" />
                <TextBlock Text="The new entity starts as a copy of the template." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Name -->
            <StackPanel Visibility="{Binding NeedsName, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                <TextBlock Text="{Binding NameError}" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"
                           Visibility="{Binding NameError, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>

            <!-- Duplicate options -->
            <CheckBox IsChecked="{Binding AddToRaces}" Margin="0,0,0,6" Visibility="{Binding CanAddToRaces, Converter={StaticResource BoolToVisibility}}">
                <TextBlock>
                    <Run Text="Add to the same race lists as the template:" />
                    <Run Text="{Binding RacesText, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </CheckBox>
            <CheckBox IsChecked="{Binding CopyStrings}" Margin="0,0,0,12" Visibility="{Binding CanCopyStrings, Converter={StaticResource BoolToVisibility}}"
                      Content="Give it its own name and description strings (copied from the template)" />

            <!-- Delete options -->
            <StackPanel Visibility="{Binding IsDelete, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                <TextBlock Text="{Binding UsedByText}" Margin="0,0,0,8" />
                <StackPanel Visibility="{Binding CanRestoreLowerLayer, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                    <RadioButton Content="Remove the entity from the mod" IsChecked="True" Margin="0,0,0,4" />
                    <RadioButton Content="Delete only this mod's copy and use the base version again" IsChecked="{Binding RestoreLowerLayer}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding RemoveReferences}" IsEnabled="{Binding CanRemoveReferences}"
                          Content="Remove it from lists and clear other references to it" />
            </StackPanel>
        </StackPanel>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Changes" FontWeight="SemiBold" Margin="0,4,0,4" />
            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Notes}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Card}" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Changes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ed:ChangeRow}">
                                <DockPanel Margin="0,3">
                                    <TextBlock DockPanel.Dock="Left" Width="22" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE70F;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDelete}" Value="True">
                                                        <Setter Property="Text" Value="&#xE74D;" />
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Path}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
