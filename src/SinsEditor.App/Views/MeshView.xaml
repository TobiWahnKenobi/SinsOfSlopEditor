<UserControl x:Class="SinsEditor.App.Views.MeshView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:assets="clr-namespace:SinsEditor.App.Assets"
             xmlns:viewer="clr-namespace:SinsEditor.Viewer;assembly=SinsEditor.Viewer">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="280" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,16,16">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FileText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,2" />
                <TextBlock Text="{Binding StatsText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />

                <CheckBox Content="Hardpoints (weapons red, exhausts blue, others yellow)" IsChecked="{Binding ShowPoints}" Margin="0,0,0,4" />
                <CheckBox Content="Wireframe" IsChecked="{Binding ShowWireframe}" Margin="0,0,0,12" />

                <TextBlock Text="Materials" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Materials}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type assets:MaterialRow}">
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Role}" Width="120" Style="{StaticResource Muted}" />
                                <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}">
                                    <Hyperlink Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding Target}" IsEnabled="{Binding Target, Converter={StaticResource NotNull}}">
                                        <Run Text="{Binding Text, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Hardpoints" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Points}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type assets:PointGroupRow}">
                            <DockPanel Margin="0,1">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Name}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Scale" Style="{StaticResource SectionHeader}" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Global scale" VerticalAlignment="Center" />
                    <DockPanel Grid.Column="1" Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" Text="units per meter" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBox Text="{Binding UnitsPerMeter, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 ToolTip="Game units per meter, the same for every mesh. Stored in the editor settings." />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="Measure along" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Axes}" SelectedItem="{Binding Axis}" Margin="0,2"
                              ToolTip="Length is along the ship (Z), width across (X), height up (Y)" />
                    <TextBlock Grid.Row="2" Text="Target size" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" Text="m" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBox Text="{Binding TargetMeters, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    </DockPanel>
                </Grid>
                <TextBlock Text="{Binding CurrentSizeText}" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding FactorText}" Margin="0,0,0,6" Visibility="{Binding FactorText, Converter={StaticResource NullToCollapsed}}" />
                <RadioButton Content="Save as a new mesh" IsChecked="{Binding SaveAsCopy}" GroupName="ScaleTarget" Margin="0,4,0,0" />
                <TextBox Text="{Binding CopyName, UpdateSourceTrigger=PropertyChanged}" Margin="24,2,0,4" IsEnabled="{Binding SaveAsCopy}" />
                <RadioButton Content="Replace this mesh in the mod" GroupName="ScaleTarget"
                             IsChecked="{Binding ReplaceInMod}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding ScaleError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding ScaleError, Converter={StaticResource NullToCollapsed}}" />
                <Button Content="Scale" Command="{Binding ScaleCommand}" IsEnabled="{Binding CanScale}" HorizontalAlignment="Left" MinWidth="100" Margin="0,0,0,16" />

                <TextBlock Text="Used by" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="No entity of the mod refers to this mesh." Style="{StaticResource Muted}"
                           Visibility="{Binding HasNoUsedBy, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding UsedBy}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type assets:UsageRow}">
                            <StackPanel Margin="0,2">
                                <TextBlock>
                                    <Hyperlink Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Target}">
                                        <Run Text="{Binding Title, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <viewer:MeshViewport Grid.Column="2" Mesh="{Binding Mesh}" Textures="{Binding Textures}"
                             ShowPoints="{Binding ShowPoints}" ShowWireframe="{Binding ShowWireframe}" />
    </Grid>
</UserControl>
