<UserControl x:Class="SinsEditor.App.Views.MeshView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:assets="clr-namespace:SinsEditor.App.Assets"
             xmlns:views="clr-namespace:SinsEditor.App.Views"
             xmlns:viewer="clr-namespace:SinsEditor.Viewer;assembly=SinsEditor.Viewer">
    <UserControl.Resources>
        <!-- Checkerboard behind the exported picture so transparency is visible. -->
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF3A3A3A" Geometry="M0,0 H2 V2 H0 Z" />
                    <GeometryDrawing Brush="#FF4A4A4A" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="280" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,16,16">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FileText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,2" />
                <TextBlock Text="{Binding StatsText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />

                <CheckBox Content="Hardpoints (weapons red, exhausts blue, others yellow)" IsChecked="{Binding ShowPoints}" Margin="0,0,0,4" />
                <CheckBox Content="Wireframe" IsChecked="{Binding ShowWireframe}" Margin="0,0,0,4" />
                <CheckBox Content="Draw with the game's shaders" IsChecked="{Binding UseGameShaders}" Margin="0,0,0,6"
                          ToolTip="Uses the game's own .fx files (a mod's own versions first) with the material's diffuse, data and normal maps" />
                <Grid Margin="0,0,0,4" Visibility="{Binding UseGameShaders, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Renderer" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding RenderStyles}" SelectedItem="{Binding RenderStyle}" Margin="0,2"
                              ToolTip="Game shaders: as in the game. Cel shading: the editor's own flat style with outlines, e.g. for HUD icons." />
                </Grid>

                <!-- Cel shading settings and presets -->
                <Border Visibility="{Binding IsCelShading, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Card}" Padding="10" Margin="0,2,0,8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Preset" Width="90" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="6,3" MinWidth="0" Margin="4,0,0,0"
                                    Command="{Binding DeleteCelPresetCommand}" ToolTip="Delete this preset" />
                            <ComboBox ItemsSource="{Binding CelPresets}" SelectedItem="{Binding SelectedCelPreset}" DisplayMemberPath="Name"
                                      ToolTip="Choose a preset to load it" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Save as" Width="90" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="Default" Command="{Binding ResetCelCommand}" Margin="4,0,0,0" ToolTip="Back to the default style" />
                            <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveCelPresetCommand}" Margin="4,0,0,0"
                                    ToolTip="Saves the current style under this name (in the editor settings, for every mod)" />
                            <TextBox Text="{Binding NewCelPresetName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Preset name" />
                        </DockPanel>

                        <TextBlock Text="Fill" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <RadioButton Content="Texture" IsChecked="{Binding CelUseTexture}" GroupName="CelFill" Margin="0,0,12,0" />
                            <RadioButton Content="One colour" IsChecked="{Binding CelUseMono}" GroupName="CelFill" />
                        </StackPanel>
                        <CheckBox Content="Team colour on the texture" IsChecked="{Binding CelTeamColor}" Margin="0,0,0,4"
                                  Visibility="{Binding CelUseTexture, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Visibility="{Binding CelUseMono, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,4">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="22" Height="22" Background="{Binding CelFillBrush}" BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0" />
                                <TextBox Text="{Binding CelFillColor, UpdateSourceTrigger=PropertyChanged, Delay=300}" ToolTip="Fill colour as #RRGGBB" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding CelSwatches}" Margin="0,3,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="18" Height="18" MinWidth="0" MinHeight="0" Padding="0" Margin="0,0,3,3" Background="{Binding}" BorderBrush="Gray" ToolTip="{Binding}"
                                                Command="{Binding DataContext.SetCelFillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <DockPanel Margin="0,4,0,2">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CelBands}" Width="28" TextAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Text="Light bands" Width="90" VerticalAlignment="Center" />
                            <Slider Minimum="1" Maximum="16" Value="{Binding CelBands}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                    ToolTip="1 is flat; 2 lit and shadow; more gives more steps" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CelShadow, StringFormat={}{0:P0}}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Text="Shadow" Width="90" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding CelShadow}" VerticalAlignment="Center" ToolTip="How dark the darkest band is" />
                        </DockPanel>

                        <CheckBox Content="Lines" FontWeight="SemiBold" IsChecked="{Binding CelOutline}" Margin="0,0,0,2" />
                        <StackPanel Visibility="{Binding CelOutline, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="Inner lines (creases, overlaps)" ToolTip="Not only the outline: also where surfaces meet at an angle or parts overlap" IsChecked="{Binding CelInnerLines}" Margin="0,0,0,4" />
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="22" Height="22" Background="{Binding CelLineBrush}" BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0" />
                                <TextBox Text="{Binding CelLineColor, UpdateSourceTrigger=PropertyChanged, Delay=300}" ToolTip="Line colour as #RRGGBB" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding CelSwatches}" Margin="0,3,0,4">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="18" Height="18" MinWidth="0" MinHeight="0" Padding="0" Margin="0,0,3,3" Background="{Binding}" BorderBrush="Gray" ToolTip="{Binding}"
                                                Command="{Binding DataContext.SetCelLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CelLineWidth, StringFormat={}{0:0.#} px}" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Left" Text="Width" Width="90" VerticalAlignment="Center" />
                                <Slider Minimum="0.5" Maximum="12" Value="{Binding CelLineWidth}" SmallChange="0.5" VerticalAlignment="Center"
                                        ToolTip="In pixels of the view, and of the picture when exporting" />
                            </DockPanel>
                            <DockPanel Visibility="{Binding CelInnerLines, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CelCreaseAngle, StringFormat={}{0:0}°}" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Left" Text="Crease angle" Width="90" VerticalAlignment="Center" />
                                <Slider Minimum="5" Maximum="120" Value="{Binding CelCreaseAngle}" VerticalAlignment="Center"
                                        ToolTip="Surfaces meeting at a sharper angle than this get a line; lower means more lines" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,4" Visibility="{Binding UseGameShaders, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Shader" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Shaders}" SelectedItem="{Binding Shader}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="Skybox" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Skyboxes}" SelectedItem="{Binding Skybox}" Margin="0,2"
                              ToolTip="The environment and irradiance cube maps the ship reflects and is lit by" />
                    <TextBlock Grid.Row="2" Text="Team colour" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TeamColorChoices}" SelectedItem="{Binding TeamColor}" Margin="0,2" />
                    <TextBlock Grid.Row="3" Text="Star distance" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding StarDistanceChoices}" SelectedItem="{Binding StarDistance}" Margin="0,2"
                              ToolTip="Where the light comes from. Remastered's PBR shaders light ships brighter close to a star." />
                </Grid>
                <StackPanel Visibility="{Binding UseGameShaders, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Background" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding BackgroundChoiceList}" SelectedItem="{Binding Background}"
                                  ToolTip="Skybox, or a fixed 2D picture behind the model (e.g. a button without its icon)" />
                    </Grid>
                    <DockPanel Margin="100,2,0,2" Visibility="{Binding IsImageBackground, Converter={StaticResource BoolToVisibility}}">
                        <Button DockPanel.Dock="Right" Content="Choose…" Command="{Binding LoadBackgroundFileCommand}" Margin="6,0,0,0" />
                        <TextBlock Text="{Binding BackgroundText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Margin="100,2,0,2" Visibility="{Binding IsBrushBackground, Converter={StaticResource BoolToVisibility}}">
                        <views:SuggestBox Items="{Binding BrushNames}" Text="{Binding BackgroundBrush, Delay=300}"
                                          ToolTip="The brush's image is the background; type to search" />
                        <TextBlock Text="{Binding BackgroundText}" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                    <CheckBox Content="Skybox backdrop" IsChecked="{Binding ShowSkybox}" Margin="0,2,0,4"
                              ToolTip="Off: only the skybox's reflections and lighting" />

                    <StackPanel Visibility="{Binding HasParticleEffects, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,4">
                        <CheckBox Content="Particles" IsChecked="{Binding ShowParticles}" Margin="0,0,0,4"
                                  ToolTip="The particle effects on Flair- hardpoints, simulated" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Command="{Binding RestartCommand}" ToolTip="Back to the start" Padding="8,4" Margin="0,0,4,0" />
                            <Button Content="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Command="{Binding StepBackCommand}" ToolTip="Step back" Padding="8,4" Margin="0,0,4,0" />
                            <Button Content="{Binding PlayText}" Command="{Binding PlayPauseCommand}" MinWidth="64" Margin="0,0,4,0" />
                            <Button Content="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Command="{Binding StepForwardCommand}" ToolTip="Step forward" Padding="8,4" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding PlaybackSpeed}" ItemStringFormat="{}{0}×" Width="80" ToolTip="Playback speed" />
                        </StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Muted}" Width="56" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider Minimum="0" Maximum="{Binding ParticleDuration}" Value="{Binding ParticleTime}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Text="Picture" Style="{StaticResource SectionHeader}" Margin="0,8,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="For brush" VerticalAlignment="Center" />
                        <views:SuggestBox Grid.Column="1" Items="{Binding BrushNames}" Margin="0,2" Text="{Binding ExportBrush, Delay=300}"
                                          ToolTip="Optional: takes the brush's size, and the picture can go into its brush editor; type to search" />
                        <TextBlock Grid.Row="1" Text="Size" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                            <TextBox Text="{Binding ExportWidth, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="70" />
                            <TextBlock Text=" × " VerticalAlignment="Center" />
                            <TextBox Text="{Binding ExportHeight, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="70" />
                        </StackPanel>
                        <CheckBox Grid.Row="2" Grid.Column="1" Content="On the brush's current image" IsChecked="{Binding ExportOnBrushImage}" Margin="0,2"
                                  ToolTip="Use the brush's image as background instead of the one chosen above" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                        <Button Content="Preview" Command="{Binding PreviewExportCommand}" Margin="0,0,6,0" />
                        <Button Content="Save image…" Command="{Binding SaveImageCommand}" Margin="0,0,6,0" />
                        <Button Content="Use in brush…" Command="{Binding UseInBrushCommand}" IsEnabled="{Binding CanUseInBrush}"
                                ToolTip="Opens the brush editor with this picture as the new Normal image" />
                    </StackPanel>
                    <TextBlock Text="{Binding ExportText}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                    <Border Background="{StaticResource Checker}" HorizontalAlignment="Left" Margin="0,4,0,8"
                            Visibility="{Binding ExportPreview, Converter={StaticResource NullToCollapsed}}">
                        <Image Source="{Binding ExportPreview}" MaxWidth="256" MaxHeight="256" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </StackPanel>
                <CheckBox Content="Cloud layer" IsChecked="{Binding ShowClouds}" Margin="0,0,0,4"
                          Visibility="{Binding HasClouds, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ShaderNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12"
                           Visibility="{Binding UseGameShaders, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="Materials" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Materials}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type assets:MaterialRow}">
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Role}" Width="120" Style="{StaticResource Muted}" />
                                <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}">
                                    <Hyperlink Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding Target}" IsEnabled="{Binding Target, Converter={StaticResource NotNull}}">
                                        <Run Text="{Binding Text, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Hardpoints" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Points}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type assets:PointGroupRow}">
                            <DockPanel Margin="0,1">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Name}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding HasAttachedParticles, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Attached particles" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding AttachedParticles}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type assets:AttachedParticleRow}">
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Text}" />
                                    <ItemsControl ItemsSource="{Binding MeshLinks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="12,0,0,0" FontSize="12">
                                                    <Hyperlink Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding Target}">
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="Scale" Style="{StaticResource SectionHeader}" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Global scale" VerticalAlignment="Center" />
                    <DockPanel Grid.Column="1" Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" Text="units per meter" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBox Text="{Binding UnitsPerMeter, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 ToolTip="Game units per meter, the same for every mesh. Stored in the editor settings." />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="Measure along" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Axes}" SelectedItem="{Binding Axis}" Margin="0,2"
                              ToolTip="Length is along the ship (Z), width across (X), height up (Y)" />
                    <TextBlock Grid.Row="2" Text="Target size" VerticalAlignment="Center" />
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" Text="m" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBox Text="{Binding TargetMeters, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    </DockPanel>
                </Grid>
                <TextBlock Text="{Binding CurrentSizeText}" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding FactorText}" Margin="0,0,0,6" Visibility="{Binding FactorText, Converter={StaticResource NullToCollapsed}}" />
                <RadioButton Content="Save as a new mesh" IsChecked="{Binding SaveAsCopy}" GroupName="ScaleTarget" Margin="0,4,0,0" />
                <TextBox Text="{Binding CopyName, UpdateSourceTrigger=PropertyChanged}" Margin="24,2,0,4" IsEnabled="{Binding SaveAsCopy}" />
                <RadioButton Content="Replace this mesh in the mod" GroupName="ScaleTarget"
                             IsChecked="{Binding ReplaceInMod}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding ScaleAlsoText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding ScaleAlsoText, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Text="{Binding ScaleError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding ScaleError, Converter={StaticResource NullToCollapsed}}" />
                <Button Content="Scale" Command="{Binding ScaleCommand}" IsEnabled="{Binding CanScale}" HorizontalAlignment="Left" MinWidth="100" Margin="0,0,0,16" />

                <TextBlock Text="Used by" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="No entity of the mod refers to this mesh." Style="{StaticResource Muted}"
                           Visibility="{Binding HasNoUsedBy, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding UsedBy}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type assets:UsageRow}">
                            <StackPanel Margin="0,2">
                                <TextBlock>
                                    <Hyperlink Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Target}">
                                        <Run Text="{Binding Title, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Column="2" ClipToBounds="True" Visibility="{Binding UseGameShaders, Converter={StaticResource BoolToVisibility}}">
            <viewer:GameMeshView Scene="{Binding GameScene}" ShowPoints="{Binding ShowPoints}" ShowWireframe="{Binding ShowWireframe}"
                                 ShowParticles="{Binding ShowParticles}" ParticleTime="{Binding ParticleTime}" IsPlaying="{Binding IsPlaying}"
                                 PlaybackSpeed="{Binding PlaybackSpeed}" ParticleDuration="{Binding ParticleDuration}" Capture="{Binding Capture}"
                                 Camera="{Binding Camera}" LightDirection="{Binding LightDirection}" Cel="{Binding ViewCel}" />

            <!-- View palette: slides in from the right. -->
            <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Padding="8,4" Panel.ZIndex="2"
                          IsChecked="{Binding IsPaletteOpen}" ToolTip="View: reset, top-down, rotate, move, field of view, stored views">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="View" />
                </StackPanel>
            </ToggleButton>
            <Border Width="310" HorizontalAlignment="Right" Margin="0,44,8,8" VerticalAlignment="Top" Panel.ZIndex="1"
                    Padding="12" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <Border.RenderTransform>
                    <TranslateTransform X="330" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaletteOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="330" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
                    <StackPanel>
                        <TextBlock Text="View" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Reset" Command="{Binding ResetViewCommand}" Margin="0,0,4,4" ToolTip="Front-left, above, the whole mesh in view (also: double-click the view)" />
                            <Button Content="Top-down" Command="{Binding TopDownViewCommand}" Margin="0,0,4,4" ToolTip="From above, bow up" />
                            <Button Content="Front" Command="{Binding FrontViewCommand}" Margin="0,0,4,4" />
                            <Button Content="Side" Command="{Binding SideViewCommand}" Margin="0,0,4,4" />
                            <Button Content="Back" Command="{Binding BackViewCommand}" Margin="0,0,4,4" />
                        </WrapPanel>

                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding FieldOfView, StringFormat={}{0:0}°}" Width="36" TextAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Text="Field of view" Width="90" VerticalAlignment="Center" />
                            <Slider Minimum="5" Maximum="120" Value="{Binding FieldOfView}" VerticalAlignment="Center" SmallChange="1" LargeChange="5" />
                        </DockPanel>

                        <TextBlock Text="Rotate around the target" Style="{StaticResource Muted}" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding RotateDegrees, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="52" />
                            <TextBlock Text="° around" VerticalAlignment="Center" Margin="4,0,4,0" />
                            <ComboBox ItemsSource="{Binding AxisNames}" SelectedItem="{Binding RotateAxis}" Width="70" />
                            <Button Content="−" Command="{Binding RotateCommand}" CommandParameter="-" Margin="6,0,2,0" MinWidth="32" />
                            <Button Content="+" Command="{Binding RotateCommand}" CommandParameter="+" MinWidth="32" />
                        </StackPanel>

                        <TextBlock Text="Move" Style="{StaticResource Muted}" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox Text="{Binding MoveUnits, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="52" />
                            <TextBlock Text="units on" VerticalAlignment="Center" Margin="4,0,4,0" />
                            <ComboBox ItemsSource="{Binding AxisNames}" SelectedItem="{Binding MoveAxis}" Width="70" />
                            <Button Content="−" Command="{Binding MoveCommand}" CommandParameter="-" Margin="6,0,2,0" MinWidth="32" />
                            <Button Content="+" Command="{Binding MoveCommand}" CommandParameter="+" MinWidth="32" />
                        </StackPanel>

                        <TextBlock Text="Sun" Style="{StaticResource Muted}" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBox Text="{Binding SunDegrees, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="52" />
                            <TextBlock Text="° around" VerticalAlignment="Center" Margin="4,0,4,0" />
                            <ComboBox ItemsSource="{Binding AxisNames}" SelectedItem="{Binding SunAxis}" Width="70" />
                            <Button Content="−" Command="{Binding RotateSunCommand}" CommandParameter="-" Margin="6,0,2,0" MinWidth="32" />
                            <Button Content="+" Command="{Binding RotateSunCommand}" CommandParameter="+" MinWidth="32" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Reset sun" Command="{Binding ResetSunCommand}" Margin="0,0,4,0" />
                            <Button Content="From the camera" Command="{Binding SunFromCameraCommand}" ToolTip="Light the side you're looking at" />
                        </StackPanel>

                        <TextBlock Text="Stored views" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Store" Command="{Binding SaveViewCommand}" Margin="6,0,0,0"
                                    ToolTip="Stores camera, field of view and playback time under this name (for this mesh, in the editor settings)" />
                            <TextBox Text="{Binding NewViewName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name of the view" />
                        </DockPanel>
                        <TextBlock Text="None stored yet." Style="{StaticResource Muted}" FontSize="12"
                                   Visibility="{Binding HasNoSavedViews, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding SavedViews}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                Padding="6,3" MinWidth="0" ToolTip="Delete"
                                                Command="{Binding DataContext.DeleteViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button HorizontalContentAlignment="Left" Margin="0,0,4,0" ToolTip="Restore"
                                                Command="{Binding DataContext.RestoreViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <TextBlock>
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding Time, Mode=OneWay, StringFormat={}  {0:0.0} s}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                        </Button>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <viewer:MeshViewport Grid.Column="2" Mesh="{Binding Mesh}" Textures="{Binding Textures}" Attachments="{Binding Attachments}"
                             Visibility="{Binding UseSimpleView, Converter={StaticResource BoolToVisibility}}"
                             ShowPoints="{Binding ShowPoints}" ShowWireframe="{Binding ShowWireframe}" />
    </Grid>
</UserControl>
