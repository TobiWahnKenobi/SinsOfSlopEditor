<UserControl x:Class="SinsEditor.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SinsEditor.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{Binding ModName}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding LanguageText}" Style="{StaticResource Muted}" Margin="0,2,0,20" />

            <!-- Metric cards -->
            <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MetricCard}">
                        <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Target}" Margin="0,0,12,0" Padding="16,12"
                                HorizontalContentAlignment="Left" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Races -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Races" Style="{StaticResource SectionHeader}" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Race" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="1" Text="Capital" Style="{StaticResource Muted}" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="Titans" Style="{StaticResource Muted}" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Frigates" Style="{StaticResource Muted}" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Modules" Style="{StaticResource Muted}" TextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Research" Style="{StaticResource Muted}" TextAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Races}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RaceRow}">
                                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0">
                                            <Hyperlink Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding Target}">
                                                <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding CapitalShips}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding Titans}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding Frigates}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{Binding PlanetModules}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="{Binding Research}" TextAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Layers" Style="{StaticResource SectionHeader}" Margin="0,28,0,8" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Layer (highest first)" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="1" Text="Role" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Column="2" Text="Files" Style="{StaticResource Muted}" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Entities" Style="{StaticResource Muted}" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Overrides" Style="{StaticResource Muted}" TextAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Layers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LayerRow}">
                                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Files, StringFormat=N0}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding ActiveEntities, StringFormat=N0}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{Binding Overrides, StringFormat=N0}" TextAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Problems -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Problems" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="No problems found." Style="{StaticResource Muted}"
                               Visibility="{Binding HasNoProblems, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding ProblemGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProblemGroup}">
                                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="22" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   VerticalAlignment="Top" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE946;" />
                                                    <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                            <Setter Property="Text" Value="&#xEA39;" />
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="Text" Value="&#xE7BA;" />
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button DockPanel.Dock="Right" Content="Fix all" Margin="8,0,0,0" VerticalAlignment="Top"
                                                Command="{Binding DataContext.FixConventionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding CanFixAll, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel>
                                            <TextBlock>
                                                <Hyperlink Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding Target}">
                                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                                </Hyperlink>
                                                <Run Text="{Binding Count, Mode=OneWay, StringFormat=' · {0:N0}'}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Example}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
