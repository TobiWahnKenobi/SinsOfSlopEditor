<UserControl x:Class="SinsEditor.App.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SinsEditor.App.ViewModels"
             DataContextChanged="OnDataContextChanged">
    <DockPanel Margin="24,24,24,12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,12" />

        <!-- Search and filters -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="12,8,0,0" />
            <WrapPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,8,6"
                         ToolTip="Search by name, internal name or race" />
                <ItemsControl ItemsSource="{Binding Filters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FacetFilterViewModel}">
                            <Grid Margin="0,0,6,6">
                                <ToggleButton x:Name="Toggle" Padding="10,5">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Summary}" />
                                        <TextBlock Text=" &#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsChecked, ElementName=Toggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=Toggle}"
                                       Placement="Bottom" AllowsTransparency="True">
                                    <Border Style="{StaticResource Card}" Padding="8" MinWidth="220" MaxHeight="420"
                                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Margin="4,0,4,6">
                                                <Hyperlink Command="{Binding ClearCommand}">Clear</Hyperlink>
                                            </TextBlock>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Values}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:FacetValueViewModel}">
                                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="4,1">
                                                                <TextBlock>
                                                                    <Run Text="{Binding Value, Mode=OneWay}" />
                                                                    <Run Text="{Binding Count, Mode=OneWay, StringFormat='  {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </TextBlock>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock VerticalAlignment="Top" Margin="6,8,0,0"
                           Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}">
                    <Hyperlink Command="{Binding ClearFiltersCommand}">Clear all</Hyperlink>
                </TextBlock>
            </WrapPanel>
        </DockPanel>

        <DataGrid x:Name="Grid" ItemsSource="{Binding View}" Style="{StaticResource ListGrid}"
                  MouseDoubleClick="List_MouseDoubleClick" PreviewKeyDown="List_KeyDown">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="48" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:EntityRow}">
                            <Image Source="{Binding Icon}" Width="36" Height="26" Stretch="Uniform" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Name" Width="2*" MinWidth="160" SortMemberPath="DisplayName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:EntityRow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA; " FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource WarningBrush}"
                                           VerticalAlignment="Center" ToolTip="Has problems"
                                           Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Hyperlink Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}">
                                        <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Internal name" Width="2*" MinWidth="160" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Races" Width="*" MinWidth="100" Binding="{Binding Races}" />
                <DataGridTextColumn Header="Layer" Width="*" MinWidth="100" Binding="{Binding Layer}" />
                <!-- Columns for the detected properties are added in code. -->
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
