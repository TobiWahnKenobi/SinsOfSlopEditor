<UserControl x:Class="SinsEditor.App.Views.TextureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:assets="clr-namespace:SinsEditor.App.Assets">
    <UserControl.Resources>
        <!-- Checkerboard behind the image so transparency is visible. -->
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF3A3A3A" Geometry="M0,0 H2 V2 H0 Z" />
                    <GeometryDrawing Brush="#FF4A4A4A" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,16,16">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding InfoText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
                <CheckBox Content="Actual size" IsChecked="{Binding ActualSize}" Margin="0,0,0,12" />

                <TextBlock Text="Used by" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="No brush or entity refers to this texture directly (meshes may)." Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Visibility="{Binding HasNoUsedBy, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding UsedBy}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type assets:UsageRow}">
                            <StackPanel Margin="0,2">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Hyperlink Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Target}">
                                        <Run Text="{Binding Title, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="16">
            <Border Background="{StaticResource Checker}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding Image}" RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Stretch" Value="Uniform" />
                            <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                            <Setter Property="MaxHeight" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActualSize}" Value="True">
                                    <Setter Property="Stretch" Value="None" />
                                    <Setter Property="MaxWidth" Value="Infinity" />
                                    <Setter Property="MaxHeight" Value="Infinity" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
