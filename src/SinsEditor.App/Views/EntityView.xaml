<UserControl x:Class="SinsEditor.App.Views.EntityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SinsEditor.App.ViewModels"
             xmlns:ed="clr-namespace:SinsEditor.App.Editing"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <!-- Connected items: a list of reference groups; every resolved entity reference is a link. -->
        <DataTemplate x:Key="ReferenceGroupTemplate" DataType="{x:Type vm:ReferenceGroup}">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ReferenceRow}">
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Key}" Width="200" Style="{StaticResource Muted}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}" />
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Resolved}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                    <Setter Property="ToolTip" Value="Doesn't exist" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Hyperlink Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" IsEnabled="{Binding NavTarget, Converter={StaticResource NotNull}}">
                                        <Run Text="{Binding Text, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Form rows. Every row: key (indented by depth) | editor | list actions. -->
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="Margin" Value="{Binding Depth, Converter={StaticResource DepthToMargin}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Context}" />
        </Style>
        <Style x:Key="EditorBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                    <Setter Property="ToolTip" Value="{Binding Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ItemActions" DataType="{x:Type ed:PropertyRowViewModel}">
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsListItem, Converter={StaticResource BoolToVisibility}}">
                <Button Content="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="6,3" MinWidth="0" Margin="4,0,0,0"
                        Command="{Binding DuplicateCommand}" ToolTip="Duplicate this item (the count is updated)" />
                <Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="6,3" MinWidth="0" Margin="4,0,0,0"
                        Command="{Binding RemoveCommand}" ToolTip="Remove this item (the count is updated)" />
            </StackPanel>
        </DataTemplate>

        <ed:PropertyRowTemplateSelector x:Key="RowTemplates">
            <ed:PropertyRowTemplateSelector.Section>
                <DataTemplate DataType="{x:Type ed:PropertyRowViewModel}">
                    <DockPanel Margin="0,8,0,2">
                        <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource ItemActions}" />
                        <TextBlock Text="{Binding Key}" Style="{StaticResource KeyText}" FontWeight="SemiBold" />
                    </DockPanel>
                </DataTemplate>
            </ed:PropertyRowTemplateSelector.Section>

            <ed:PropertyRowTemplateSelector.Counter>
                <DataTemplate DataType="{x:Type ed:PropertyRowViewModel}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Key}" Style="{StaticResource KeyText}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding Value}" VerticalAlignment="Center" MinWidth="40" />
                            <TextBlock Text="managed by the editor" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="8,0,12,0"
                                       ToolTip="The game reads exactly this many items, so the editor updates it when items are added or removed." />
                            <Button Content="Add item" Padding="8,2" Command="{Binding AddItemCommand}"
                                    Visibility="{Binding CanAddItem, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ed:PropertyRowTemplateSelector.Counter>

            <ed:PropertyRowTemplateSelector.Bool>
                <DataTemplate DataType="{x:Type ed:PropertyRowViewModel}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Key}" Style="{StaticResource KeyText}" />
                        <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue}" VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource ItemActions}" />
                    </Grid>
                </DataTemplate>
            </ed:PropertyRowTemplateSelector.Bool>

            <ed:PropertyRowTemplateSelector.Text>
                <DataTemplate DataType="{x:Type ed:PropertyRowViewModel}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Key}" Style="{StaticResource KeyText}" />
                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" Style="{StaticResource EditorBox}" />
                        <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource ItemActions}" />
                    </Grid>
                </DataTemplate>
            </ed:PropertyRowTemplateSelector.Text>

            <ed:PropertyRowTemplateSelector.Choice>
                <DataTemplate DataType="{x:Type ed:PropertyRowViewModel}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Key}" Style="{StaticResource KeyText}" />
                        <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding Choices}"
                                  Text="{Binding Value, UpdateSourceTrigger=LostFocus}" ToolTip="Values used elsewhere are listed; other text is allowed" />
                        <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource ItemActions}" />
                    </Grid>
                </DataTemplate>
            </ed:PropertyRowTemplateSelector.Choice>

            <ed:PropertyRowTemplateSelector.Reference>
                <DataTemplate DataType="{x:Type ed:PropertyRowViewModel}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Key}" Style="{StaticResource KeyText}" />
                        <StackPanel Grid.Column="1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="&#xE8AD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="6,3" MinWidth="0"
                                        Margin="4,0,0,0" Command="{Binding GoToCommand}" ToolTip="Open (Ctrl+click: new tab)"
                                        Visibility="{Binding CanGoTo, Converter={StaticResource BoolToVisibility}}" />
                                <Grid DockPanel.Dock="Right">
                                    <Button x:Name="PickerButton" Content="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="6,3" MinWidth="0"
                                            Margin="4,0,0,0" Command="{Binding OpenPickerCommand}" ToolTip="Choose from existing items" />
                                    <Popup IsOpen="{Binding IsPickerOpen}" StaysOpen="False" PlacementTarget="{Binding ElementName=PickerButton}"
                                           Placement="Bottom" AllowsTransparency="True" Opened="Picker_Opened">
                                        <Border Style="{StaticResource Card}" Padding="8" Width="520" MaxHeight="440"
                                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                                            <DockPanel>
                                                <TextBox DockPanel.Dock="Top" Text="{Binding PickerQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                                         PreviewKeyDown="PickerQuery_PreviewKeyDown" />
                                                <ListBox ItemsSource="{Binding PickerResults}" BorderThickness="0" MouseUp="PickerList_MouseUp"
                                                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type ed:PickerItem}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding Value, Mode=OneWay}" />
                                                                    <Run Text="{Binding Detail, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </DockPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" Style="{StaticResource EditorBox}" />
                            </DockPanel>
                            <TextBlock Text="{Binding ValueDescription}" Style="{StaticResource Muted}" FontSize="12" Margin="2,1,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding ValueDescription, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="2,1,0,0"
                                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource ItemActions}" VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ed:PropertyRowTemplateSelector.Reference>
        </ed:PropertyRowTemplateSelector>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,12">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Image DockPanel.Dock="Left" Source="{Binding Icon}" MaxHeight="48" MaxWidth="72" Margin="0,0,16,0" VerticalAlignment="Top"
                   Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="8,5" MinWidth="0" Margin="0,0,4,0"
                        Command="{Binding UndoCommand}" ToolTip="{Binding UndoToolTip}" />
                <Button Content="&#xE7A6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="8,5" MinWidth="0" Margin="0,0,12,0"
                        Command="{Binding RedoCommand}" ToolTip="{Binding RedoToolTip}" />
                <ComboBox ItemsSource="{Binding SaveFormats}" SelectedItem="{Binding SelectedFormat}" Width="100" Margin="0,0,4,0"
                          ToolTip="Save as text, or convert to binary with ConvertData" />
                <Button Content="Save" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="80"
                        ToolTip="Save (Ctrl+S)" />
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="  ●" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               ToolTip="Unsaved changes" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding LayerText}" Style="{StaticResource Muted}" />
                <ItemsControl ItemsSource="{Binding Races}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ReferenceRow}">
                            <TextBlock Margin="0,0,12,0">
                                <Run Text="Race:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Hyperlink Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}">
                                    <Run Text="{Binding TargetDisplayName, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                Visibility="{Binding OverrideNotice, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding OverrideNotice}" TextWrapping="Wrap" />
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,0,0,8"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />

        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Properties">
                <DockPanel Margin="0,12,0,0">
                    <TextBox DockPanel.Dock="Top" Text="{Binding Editor.FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             Width="320" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="Filter properties by key or value" />
                    <ItemsControl ItemsSource="{Binding Editor.View}" ItemTemplateSelector="{StaticResource RowTemplates}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True" KeyboardNavigation.TabNavigation="Cycle">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DockPanel>
            </TabItem>
            <TabItem Header="Connected items">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Uses" Style="{StaticResource SectionHeader}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Uses}" ItemTemplate="{StaticResource ReferenceGroupTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Used by" Style="{StaticResource SectionHeader}" />
                        <TextBlock DockPanel.Dock="Top" Text="Nothing refers to this entity." Style="{StaticResource Muted}"
                                   Visibility="{Binding HasNoUsedBy, Converter={StaticResource BoolToVisibility}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding UsedBy}" ItemTemplate="{StaticResource ReferenceGroupTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Raw text">
                <avalon:TextEditor x:Name="RawEditor" FontFamily="Cascadia Mono, Consolas" FontSize="13" ShowLineNumbers="True"
                                   Margin="0,12,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}"
                                   LostKeyboardFocus="RawEditor_LostKeyboardFocus" />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
