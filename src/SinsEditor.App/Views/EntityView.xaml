<UserControl x:Class="SinsEditor.App.Views.EntityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SinsEditor.App.ViewModels">
    <UserControl.Resources>
        <!-- A list of reference groups; every resolved entity reference is a link. -->
        <DataTemplate x:Key="ReferenceGroupTemplate" DataType="{x:Type vm:ReferenceGroup}">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ReferenceRow}">
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Key}" Width="200" Style="{StaticResource Muted}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}" />
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Resolved}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                    <Setter Property="ToolTip" Value="Doesn't exist" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Hyperlink Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" IsEnabled="{Binding NavTarget, Converter={StaticResource NotNull}}">
                                        <Run Text="{Binding Text, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24,24,24,12">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Image DockPanel.Dock="Left" Source="{Binding Icon}" MaxHeight="48" MaxWidth="72" Margin="0,0,16,0" VerticalAlignment="Top"
                   Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
            <StackPanel>
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding LayerText}" Style="{StaticResource Muted}" />
                <ItemsControl ItemsSource="{Binding Races}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ReferenceRow}">
                            <TextBlock Margin="0,0,12,0">
                                <Run Text="Race:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Hyperlink Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}">
                                    <Run Text="{Binding TargetDisplayName, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DockPanel>

        <TabControl>
            <TabItem Header="Connected items">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Uses" Style="{StaticResource SectionHeader}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Uses}" ItemTemplate="{StaticResource ReferenceGroupTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Used by" Style="{StaticResource SectionHeader}" />
                        <TextBlock DockPanel.Dock="Top" Text="Nothing refers to this entity." Style="{StaticResource Muted}"
                                   Visibility="{Binding HasNoUsedBy, Converter={StaticResource BoolToVisibility}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding UsedBy}" ItemTemplate="{StaticResource ReferenceGroupTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Raw text">
                <TextBox Text="{Binding RawText, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"
                         AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Margin="0,12,0,0" />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
